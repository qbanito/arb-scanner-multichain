# Copy this file to .env and fill in real values there.
# .env is git-ignored — never commit it. Never paste PRIVATE_KEY in a chat,
# screenshot, or issue tracker.

# Where the scanner API lives.
API_BASE_URL=http://localhost:8080

# Owner wallet of the deployed ArbExecutor contract(s) — same key used to
# deploy in artifacts/arb-executor, or another wallet you've since made
# owner. This bot signs and sends `initiateArbitrage` transactions with it.
PRIVATE_KEY=0x...

# At least one chain needs both an RPC URL and a deployed ArbExecutor
# address to be usable. Leave a chain's two vars unset to disable it.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_WS_URL=
ARB_EXECUTOR_ARBITRUM=0x...

ETHEREUM_RPC_URL=
ETHEREUM_WS_URL=
ARB_EXECUTOR_ETHEREUM=

OPTIMISM_RPC_URL=
OPTIMISM_WS_URL=
ARB_EXECUTOR_OPTIMISM=

POLYGON_RPC_URL=
POLYGON_WS_URL=
ARB_EXECUTOR_POLYGON=

# Additional networks. Setting only the RPC enables safe watch-only mode;
# execution is enabled per chain only after its verified deployment address
# is also configured and the global ENABLE_LIVE_EXECUTION gate is true.
BASE_RPC_URL=https://base-rpc.publicnode.com
BASE_WS_URL=
BASE_RPC_URL_FALLBACK=https://base-rpc.publicnode.com
ARB_EXECUTOR_BASE=

AVALANCHE_RPC_URL=https://avalanche-c-chain-rpc.publicnode.com
AVALANCHE_RPC_URL_FALLBACK=https://avalanche-c-chain-rpc.publicnode.com
ARB_EXECUTOR_AVALANCHE=

BSC_RPC_URL=https://bsc-rpc.publicnode.com
BSC_RPC_URL_FALLBACK=https://bsc-rpc.publicnode.com
ARB_EXECUTOR_BSC=

CELO_RPC_URL=https://celo-rpc.publicnode.com
CELO_RPC_URL_FALLBACK=https://celo-rpc.publicnode.com
ARB_EXECUTOR_CELO=

LINEA_RPC_URL=https://linea-rpc.publicnode.com
LINEA_RPC_URL_FALLBACK=https://linea-rpc.publicnode.com
ARB_EXECUTOR_LINEA=

MANTLE_RPC_URL=https://mantle-rpc.publicnode.com
MANTLE_RPC_URL_FALLBACK=https://mantle-rpc.publicnode.com
ARB_EXECUTOR_MANTLE=

SCROLL_RPC_URL=https://scroll-rpc.publicnode.com
SCROLL_RPC_URL_FALLBACK=https://scroll-rpc.publicnode.com
ARB_EXECUTOR_SCROLL=

SONIC_RPC_URL=https://sonic-rpc.publicnode.com
SONIC_RPC_URL_FALLBACK=https://sonic-rpc.publicnode.com
ARB_EXECUTOR_SONIC=

ZKSYNC_RPC_URL=https://mainnet.era.zksync.io
ZKSYNC_RPC_URL_FALLBACK=https://mainnet.era.zksync.io
ARB_EXECUTOR_ZKSYNC=

SONEIUM_RPC_URL=https://soneium-rpc.publicnode.com
SONEIUM_RPC_URL_FALLBACK=https://soneium-rpc.publicnode.com
ARB_EXECUTOR_SONEIUM=

# SAFETY: keep this false until you've watched dry-run logs for a while and
# are confident in the sizing/limits below. See README.md.
ENABLE_LIVE_EXECUTION=false

# Keep true to require the dashboard execution button. When true, profitable
# scanner candidates are monitored but never submitted automatically.
REQUIRE_MANUAL_EXECUTION=true

# Max size (in USD-equivalent, stablecoin-quoted trades only) to flash-borrow
# per trade.
MAX_BORROW_USD=250

# Off-chain pre-filter: skip opportunities the scanner estimates below this
# net profit, before spending RPC calls building a route for them.
MIN_PROFIT_USD=20

# Optional BNB-only admission floor. Exact gas/profit and on-chain minimum
# checks still apply before a transaction can be sent.
MIN_PROFIT_USD_BSC=1

# On-chain hard floor, in basis points of the borrowed amount — enforced by
# ArbExecutor itself regardless of what the off-chain estimate said.
MIN_PROFIT_BPS_ON_CHAIN=15

# Exact on-chain profit must cover estimated gas by at least this multiplier.
MIN_PROFIT_OVER_GAS_MULTIPLIER=2

# Hard cap on live transactions per rolling hour, regardless of how many
# profitable-looking opportunities appear.
MAX_TRADES_PER_HOUR=3

POLL_INTERVAL_MS=15000

# Minimum spacing between block-triggered evaluations. The default reacts in
# one second while preventing fast L2 block streams from exhausting the RPC.
MIN_TICK_GAP_MS=1000

# Per-swap-leg slippage tolerance, in basis points, applied to each Uniswap
# V3 quote.
SLIPPAGE_BPS=50

# Sweep each confirmed profit out of ArbExecutor immediately. If BNB falls
# below the trigger, convert no more than that trade's confirmed profit until
# the target reserve is reached. Existing wallet tokens are never spent.
AUTO_GAS_RESERVE=false
BSC_GAS_RESERVE_TRIGGER_BNB=0.0025
BSC_GAS_RESERVE_TARGET_BNB=0.004
GAS_RESERVE_SLIPPAGE_BPS=100

# Liquidations (optional — see src/liquidation/). Free API key from
# thegraph.com/studio, used to find Aave borrowers; real-time Health Factor
# is always read on-chain, never from the subgraph.
GRAPH_API_KEY=
ENABLE_LIQUIDATIONS=false
LIQUIDATION_SCAN_INTERVAL_MS=60000

# Optional: route Ethereum mainnet transactions through Flashbots Protect
# instead of the public mempool, to avoid being front-run and to compete for
# builder inclusion the way most serious liquidation bots do (see
# src/liquidation/strategyAnalysis.ts). Only affects chainId 1 — Arbitrum has
# no public mempool for this to protect against. Leave unset to send through
# the normal RPC as before. "/fast" variant trades some privacy (shares more
# tx info with searchers in TEEs) for broader builder distribution / faster
# inclusion odds — see https://docs.flashbots.net/flashbots-protect/overview
FLASHBOTS_PROTECT_RPC_URL=https://rpc.flashbots.net/fast

# Optional Ethereum MEV-Share early-warning stream. It triggers an immediate
# re-scan when private order-flow hints arrive; it does not submit a backrun
# unless a target-aware bundle can be simulated safely.
ENABLE_MEV_SHARE_HINTS=false
MEV_SHARE_STREAM_URL=https://mev-share.flashbots.net
