{
  "name": "@workspace/executor-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --env-file-if-exists=.env --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "scan:liquidations": "tsx src/liquidation/scanCli.ts",
    "scan:competitors": "tsx src/liquidation/competitorAnalysis.ts",
    "scan:strategy": "tsx src/liquidation/strategyAnalysis.ts",
    "backtest:liquidations": "tsx src/liquidation/backtestLiquidations.ts",
    "audit:coverage": "tsx src/liquidation/assetCoverageAudit.ts",
    "analyze:readiness": "tsx src/liquidation/liquidationReadiness.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "pino": "^9.14.0",
    "viem": "^2.38.5",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
