# Copy to .env and fill values locally. Never commit a private key.
TARGET_RPC_URL=
PRIVATE_KEY=0x...
OWNER=0x...

# Verify against the current Aave address book before every deployment.
# Ethereum, Arbitrum, Optimism and Polygon currently share this provider.
POOL_ADDRESSES_PROVIDER=0xa97684ead0e402dC232d5A977953DF7ECBaB3CDb

# Comma-separated ERC-20/router/pool targets used by the enabled adapters.
# Do not add an address until it has been verified from a primary source.
ALLOWED_TARGETS=
