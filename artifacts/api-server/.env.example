# Across quote layer. Keep execution disabled until destination inventory,
# reconciliation and an explicit settlement policy are implemented.
ACROSS_ENABLED=false
ACROSS_API_BASE_URL=https://app.across.to/api
ACROSS_API_KEY=
ACROSS_INTEGRATOR_ID=
# Optional comma-separated allow-list for the verified scanner/Across overlap.
ACROSS_ALLOWED_CHAIN_IDS=1,10,56,137,324,1868,59144,8453,42161,43114
ACROSS_MAX_CHAINS=10
# One chain per cycle keeps public indexers below their rate limits while the
# in-process cache retains the other chains for cross-chain comparisons.
ACROSS_CHAINS_PER_CYCLE=1
ACROSS_SCAN_TOKENS=WETH,USDC,USDT,DAI,WBTC
# Memecoins are opt-in because thin pools and transfer taxes can make a raw
# cross-chain price dislocation non-executable.
ACROSS_MEME_ENABLED=false
ACROSS_MEME_TOKENS=PEPE,FLOKI,MOG,SHIB,TURBO
ACROSS_MEME_MIN_POOL_LIQUIDITY_USD=250000
ACROSS_MEME_MIN_SPREAD_BPS=150
ACROSS_MEME_MIN_NET_PROFIT_USD=10
